generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Transaction {
  id          String    @id @default(cuid())
  date        DateTime
  description String
  amount      Decimal   @db.Decimal(12, 2)
  source      Source
  externalId  String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  receiptId   String?
  receipt     Receipt?  @relation(fields: [receiptId], references: [id])
  vendorId    String?
  vendor      Vendor?   @relation(fields: [vendorId], references: [id])
  matched     Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
  @@index([categoryId])
  @@index([receiptId])
  @@index([vendorId])
  @@index([matched])
}

model Receipt {
  id           String        @id @default(cuid())
  imageUrl     String
  fileName     String?
  ocrText      String?
  ocrAmount    Decimal?      @db.Decimal(12, 2)
  ocrDate      DateTime?
  ocrVendor    String?
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId])
  @@index([ocrDate])
}

model Category {
  id           String        @id @default(cuid())
  name         String
  type         CategoryType
  keywords     String[]
  color        String?
  transactions Transaction[]
  receipts     Receipt[]
  rules        MatchingRule[]
  vendors      Vendor[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([name, type])
}

model MatchingRule {
  id         String   @id @default(cuid())
  pattern    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  confidence Float    @default(1.0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

model Settings {
  id                  String   @id @default(cuid())
  stripeSecretKey     String?
  stripeWebhookSecret String?
  googleCloudKey      String?
  // Email ingestion settings
  emailAddress        String?  // e.g., invoice@mettehummel.dk
  emailProvider       String?  // mailgun, sendgrid, postmark
  emailWebhookSecret  String?  // For verifying incoming webhooks
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model EmailLog {
  id              String   @id @default(cuid())
  sender          String
  subject         String?
  attachmentCount Int      @default(0)
  processedAt     DateTime @default(now())
  status          String   @default("processed")
  errorMessage    String?

  @@index([processedAt])
}

// Auto-learned vendors from transactions
model Vendor {
  id              String        @id @default(cuid())
  name            String        // Display name, e.g., "Meta/Facebook"
  patterns        String[]      // Patterns to match, e.g., ["META", "FACEBOOK", "FB ADS"]
  defaultCategoryId String?
  defaultCategory Category?     @relation(fields: [defaultCategoryId], references: [id])
  transactions    Transaction[]
  totalSpent      Decimal       @default(0) @db.Decimal(12, 2)
  transactionCount Int          @default(0)
  lastSeen        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([name])
  @@index([defaultCategoryId])
}

enum Source {
  BANK
  STRIPE
  MANUAL
}

enum CategoryType {
  INCOME
  EXPENSE
}
