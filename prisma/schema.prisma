generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  passwordHash      String
  name              String?
  companies         UserCompany[]
  activeCompanyId   String?
  activeCompany     Company?      @relation("ActiveCompany", fields: [activeCompanyId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([activeCompanyId])
}

model Company {
  id              String        @id @default(cuid())
  name            String        // e.g., "Mettes Firma ApS"
  cvr             String?       // CVR number
  address         String?
  users           UserCompany[]
  activeUsers     User[]        @relation("ActiveCompany")
  transactions    Transaction[]
  receipts        Receipt[]
  categories      Category[]
  vendors         Vendor[]
  settings        Settings?
  matchingRules   MatchingRule[]
  emailLogs       EmailLog[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String   @default("owner") // owner, admin, viewer
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model Transaction {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date        DateTime
  description String
  amount      Decimal   @db.Decimal(12, 2)
  vatAmount   Decimal?  @db.Decimal(12, 2) // Moms beløb
  vatRate     Decimal?  @db.Decimal(5, 2)  // Momssats (typisk 25%)
  source      Source
  externalId  String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  receiptId   String?
  receipt     Receipt?  @relation(fields: [receiptId], references: [id])
  vendorId    String?
  vendor      Vendor?   @relation(fields: [vendorId], references: [id])
  matched     Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([date])
  @@index([categoryId])
  @@index([receiptId])
  @@index([vendorId])
  @@index([matched])
}

model Receipt {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  imageUrl     String
  fileName     String?
  ocrStatus    String        @default("pending") // pending, processing, completed, failed, no_api_key
  ocrError     String?
  ocrText      String?
  ocrAmount    Decimal?      @db.Decimal(12, 2)
  ocrVatAmount Decimal?      @db.Decimal(12, 2) // Moms beløb fra OCR
  ocrDate      DateTime?
  ocrVendor    String?
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([companyId])
  @@index([categoryId])
  @@index([ocrDate])
  @@index([ocrStatus])
}

model Category {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  type         CategoryType
  keywords     String[]
  color        String?
  transactions Transaction[]
  receipts     Receipt[]
  rules        MatchingRule[]
  vendors      Vendor[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([companyId, name, type])
  @@index([companyId])
}

model MatchingRule {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pattern    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  confidence Float    @default(1.0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([categoryId])
}

model Settings {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stripeSecretKey     String?
  stripeWebhookSecret String?
  googleCloudKey      String?
  // Email ingestion settings
  emailAddress        String?  // e.g., invoice@mettehummel.dk
  emailProvider       String?  // mailgun, sendgrid, postmark
  emailWebhookSecret  String?  // For verifying incoming webhooks
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model EmailLog {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sender          String
  subject         String?
  attachmentCount Int      @default(0)
  processedAt     DateTime @default(now())
  status          String   @default("processed")
  errorMessage    String?

  @@index([companyId])
  @@index([processedAt])
}

// Auto-learned vendors from transactions
model Vendor {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String        // Display name, e.g., "Meta/Facebook"
  patterns          String[]      // Patterns to match, e.g., ["META", "FACEBOOK", "FB ADS"]
  defaultCategoryId String?
  defaultCategory   Category?     @relation(fields: [defaultCategoryId], references: [id])
  transactions      Transaction[]
  totalSpent        Decimal       @default(0) @db.Decimal(12, 2)
  transactionCount  Int           @default(0)
  lastSeen          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([companyId])
  @@index([name])
  @@index([defaultCategoryId])
}

enum Source {
  BANK
  STRIPE
  MANUAL
}

enum CategoryType {
  INCOME
  EXPENSE
}
